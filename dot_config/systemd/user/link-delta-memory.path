[Unit]
Description=Watch for new Delta worktrees and link Claude Code memory into them

[Path]
# One line per repo that uses Delta.
PathChanged=%h/repositories/Huge-Breakthrough-Project/.delta/worktrees
PathChanged=%h/repositories/deanlemans.github.io/.delta/worktrees
Unit=link-delta-memory.service

[Install]
WantedBy=default.target
