#!/bin/sh
# mc: run the minecraft server (purpur behind velocity) in tmux sessions.
# purpur starts first, velocity only once purpur is actually up.
# stop goes the other way round so players get kicked by velocity first.
set -eu

PURPUR_DIR=$HOME/purpur-server
VELOCITY_DIR=$HOME/velocity
TIMEOUT=${MC_TIMEOUT:-300}   # seconds to wait for start/stop

running() { tmux has-session -t "=$1" 2>/dev/null; }

# up = log written after we started it + has the "Done (" line both servers print
up() { # dir
    [ "$1/logs/latest.log" -nt "$1/.mc-started" ] && grep -q 'Done (' "$1/logs/latest.log"
}

start_one() { # name dir
    if running "$1"; then
        echo "$1 already running"
        return
    fi
    echo "starting $1..."
    touch "$2/.mc-started"
    sleep 1   # so the new log is strictly newer than the marker
    tmux new-session -d -s "$1" -c "$2" ./start.sh
    i=0
    until up "$2"; do
        if ! running "$1"; then
            echo "$1 died while starting, see: mc log $1"
            exit 1
        fi
        i=$((i + 1))
        if [ "$i" -ge "$TIMEOUT" ]; then
            echo "$1 not up after ${TIMEOUT}s, see: mc console $1"
            exit 1
        fi
        sleep 1
    done
    echo "$1 up"
}

stop_one() { # name dir stopcommand
    if ! running "$1"; then
        echo "$1 not running"
        return
    fi
    echo "stopping $1..."
    touch "$2/.stop"
    tmux send-keys -t "=$1" "$3" Enter
    i=0
    while running "$1"; do
        i=$((i + 1))
        if [ "$i" -ge "$TIMEOUT" ]; then
            echo "$1 didnt stop after ${TIMEOUT}s, killing it"
            tmux kill-session -t "=$1"
            rm -f "$2/.stop"
            break
        fi
        sleep 1
    done
    echo "$1 stopped"
}

dir_of() {
    case $1 in
        purpur) echo "$PURPUR_DIR" ;;
        velocity) echo "$VELOCITY_DIR" ;;
        *) echo "unknown server '$1', use purpur or velocity" >&2; exit 1 ;;
    esac
}

status_one() { # name dir
    if running "$1"; then
        if up "$2"; then s="running"; else s="starting (or crashed + restarting, see: mc log $1)"; fi
    else
        s="stopped"
    fi
    printf '%-9s %s\n' "$1" "$s"
}

usage() {
    cat <<USAGE
usage: mc <command>
  start               start purpur, wait till its up, then velocity
  stop                stop velocity, then purpur (saves the world)
  restart             stop + start
  status              whats running
  console <server>    open its console (leave with ctrl+b then d, NOT ctrl+c)
  log <server>        follow its log file
  <server> = purpur or velocity
USAGE
}

if ! command -v tmux >/dev/null 2>&1; then
    echo "needs tmux: sudo pacman -S tmux" >&2
    exit 1
fi

case ${1:-} in
    start)
        start_one purpur "$PURPUR_DIR"
        start_one velocity "$VELOCITY_DIR"
        ;;
    stop)
        stop_one velocity "$VELOCITY_DIR" shutdown
        stop_one purpur "$PURPUR_DIR" stop
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    status)
        status_one purpur "$PURPUR_DIR"
        status_one velocity "$VELOCITY_DIR"
        ;;
    console)
        dir_of "${2:-}" >/dev/null
        exec tmux attach -t "=$2"
        ;;
    log)
        d=$(dir_of "${2:-}")
        exec tail -n 50 -f "$d/logs/latest.log"
        ;;
    *)
        usage
        ;;
esac
