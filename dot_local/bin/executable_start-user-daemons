#!/bin/sh
# starts the background helpers in ~/.local/bin, init system agnostic.
# called from xdg autostart, ~/.profile + fish login. each daemon has its own
# lock ∴ calling this again is harmless.
for d in link-agents-watch promnesia-daemon; do
	if [ -x "$HOME/.local/bin/$d" ]; then
		nohup "$HOME/.local/bin/$d" </dev/null >/dev/null 2>&1 &
	fi
done
