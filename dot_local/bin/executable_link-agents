#!/bin/sh
# hooks the ai agnostic ~/.agents (memories/ + skills/) into every installed agent.
# run by the chezmoi apply script, the claude SessionStart hook, link-agents-watch
# (new delta worktrees, memory edits) or by hand after installing an agent.
# POSIX.1-2024 sh, safe to rerun.
#   claude: CLAUDE.md imports each global memory (live), project memory dirs +
#     skills are symlinks into ~/.agents
#   codex, opencode, gemini: read ~/.agents/skills themselves + get ~/.agents/AGENTS.md
#     (generated copy of the globals + where the project memories are, no imports)
set -u
a=$HOME/.agents mem=$HOME/.agents/memories proj=$HOME/.claude/projects
log=${XDG_STATE_HOME:-$HOME/.local/state}/link-agents.log

# claude code names a project dir after its path, every non-alphanumeric as -
claude_project_slug() { printf '%s' "$1" | LC_ALL=C sed 's/[^A-Za-z0-9]/-/g'; }

# warn <msg>: stderr + log ∵ the watcher + hook run w/o a terminal
warn() {
	printf '%s\n' "$1" >&2
	mkdir -p "${log%/*}" && printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$log"
}

# make_symlink <src> <target>: make target a symlink to src, keep what was there as .bak
make_symlink() {
	[ -L "$2" ] && [ "$(readlink "$2")" = "$1" ] && return 0
	mkdir -p "${2%/*}"
	if [ -L "$2" ]; then
		rm -f "$2"
	elif [ -d "$2" ] && [ -z "$(ls -A "$2")" ]; then
		rmdir "$2"
	elif [ -e "$2" ]; then
		mv "$2" "$2.bak-$(date +%Y%m%d%H%M%S)"
		warn "kept old $2 as .bak, merge by hand"
	fi
	ln -s "$1" "$2"
}

# write_if_changed <file>: stdin -> file, only touches it when the content changed
write_if_changed() {
	cat > "$1.tmp"
	if cmp -s "$1.tmp" "$1"; then rm -f "$1.tmp"; else mv "$1.tmp" "$1"; fi
}

# skills: only claude needs links, the others read ~/.agents/skills
for s in "$a"/skills/*/; do
	[ -d "$s" ] && make_symlink "${s%/}" "$HOME/.claude/skills/$(basename "$s")"
done
for t in "$HOME"/.claude/skills/*; do # links to removed skills
	[ -L "$t" ] && [ ! -e "$t" ] && case $(readlink "$t") in "$a"/skills/*) rm -f "$t" ;; esac
done

# global memories (root memories/*.md)
f=$HOME/.claude/CLAUDE.md
touch "$f"
{
	grep -v '^@~/.agents/memories/' "$f"
	for m in "$mem"/*.md; do
		[ -f "$m" ] && printf '@~/.agents/memories/%s\n' "${m##*/}"
	done
} | write_if_changed "$f"

{
	printf '<!-- generated by ~/.local/bin/link-agents, edit ~/.agents/memories/ instead -->\n'
	for m in "$mem"/*.md; do
		[ -f "$m" ] && printf '\n' && cat "$m"
	done
	printf '\n# project memories\n\nWhen working in one of these repos (or a `.delta/worktrees/` copy of it), read its MEMORY.md first, then the memories it lists. Save new project memories there.\n\n'
	for p in "$mem"/*/.path; do
		[ -f "$p" ] && printf -- '- `~/%s`: `~/.agents/memories/%s/`\n' "$(cat "$p")" "$(basename "${p%/.path}")"
	done
} | write_if_changed "$a/AGENTS.md"
for t in .codex/AGENTS.md .config/opencode/AGENTS.md .gemini/GEMINI.md; do
	[ -d "$HOME/${t%/*}" ] && make_symlink "$a/AGENTS.md" "$HOME/$t"
done

# claude project memory: repo + each delta worktree (<repo>/.delta/worktrees/<id>/<name>)
# get a symlink to memories/<project>, ∴ every session of a repo shares it
keep=/
for p in "$mem"/*/.path; do
	[ -f "$p" ] || continue
	d=${p%/.path} repo=$HOME/$(cat "$p") s=$(claude_project_slug "$HOME/$(cat "$p")")
	make_symlink "$d" "$proj/$s/memory"
	keep=$keep$s/
	for wt in "$repo"/.delta/worktrees/*/*/; do
		[ -d "$wt" ] || continue
		s=$(claude_project_slug "${wt%/}")
		make_symlink "$d" "$proj/$s/memory"
		keep=$keep$s/
	done
done
# drop dirs of removed worktrees that only hold the memory link (sessions stay)
for d in "$proj"/*--delta-worktrees-*/; do
	d=${d%/}
	case $keep in *"/${d##*/}/"*) continue ;; esac
	[ -L "$d/memory" ] && [ "$(ls -A "$d")" = memory ] && rm -f "$d/memory" && rmdir "$d"
done
exit 0
