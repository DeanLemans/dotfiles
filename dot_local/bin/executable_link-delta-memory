#!/bin/sh
# point claude code memory of every delta worktree at its projects memory dir.
# delta runs sessions in <repo>/.delta/worktrees/<id>/<name> + claude code keys
# memory by path ∴ each worktree would get its own empty memory dir.
# projects come from ~/.agents/memories/<name>/.path (repo path relative to $HOME).
# POSIX sh (2024), no init system needed: run it by hand, from a hook, or let
# link-delta-memory-watch run it on every new worktree.
set -u
root=$HOME/.claude/projects
agents=$HOME/.agents/memories

# claude code names a project dir after its path, every non-alphanumeric as -
slug() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

link() { # link <claude project dir> <main memory dir>
	_d=$1 _main=$2 _m=$1/memory
	[ -d "$_main" ] || return 0
	if [ -L "$_m" ]; then
		[ "$(readlink "$_m")" = "$_main" ] && return 0
		printf 'skip %s: memory links somewhere else\n' "${_d##*/}" >&2
		return 0
	fi
	if [ -e "$_m" ]; then
		if [ -d "$_m" ] && [ -z "$(ls -A "$_m")" ]; then
			rmdir "$_m"
		else
			printf 'skip %s: memory dir has files, merge by hand\n' "${_d##*/}" >&2
			return 0
		fi
	fi
	mkdir -p "$_d" && ln -s "$_main" "$_m" && printf 'linked %s\n' "${_d##*/}"
}

# 1. worktrees on disk: make the link before the first session starts
for p in "$agents"/*/.path; do
	[ -f "$p" ] || continue
	repo=$HOME/$(cat "$p")
	main=$root/$(slug "$repo")/memory
	for id in "$repo"/.delta/worktrees/*/; do
		[ -d "$id" ] || continue
		id=${id%/}
		# delta checks the repo out as <id>/<repo name>, that dir may not exist yet
		link "$root/$(slug "$id/${repo##*/}")" "$main"
		for wt in "$id"/*/; do
			[ -d "$wt" ] && link "$root/$(slug "${wt%/}")" "$main"
		done
	done
done

# 2. claude project dirs pass 1 could not see
for d in "$root"/*--delta-worktrees-*; do
	[ -d "$d" ] || continue
	base=${d##*/}
	link "$d" "$root/${base%%--delta-worktrees-*}/memory"
done
exit 0
